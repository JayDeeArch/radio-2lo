{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "SPOTIFY_CLIENT_ID",
    "SPOTIFY_CLIENT_SECRET",
    "SPOTIFY_REDIRECT_URI",
    "SPOTIFY_PLAYLIST_ID",
    "SPOTIFY_MARKET",
    "SESSION_SECRET",
    "SESSION_TTL_DAYS",
    "ADMIN_SPOTIFY_IDS",
    "PUBLIC_BASE_URL",
    "TRUST_PROXY",
    "ALLOWED_ORIGINS",
    "PORT",
    "VITE_API_BASE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
