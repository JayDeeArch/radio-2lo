{
  "name": "szkolne-radio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @radio/api run db:migrate",
    "db:seed": "pnpm --filter @radio/api run db:seed",
    "spike": "pnpm --filter @radio/api run spike",
    "add-admin": "pnpm --filter @radio/api run add-admin",
    "clean": "rm -rf node_modules turbo .turbo apps/*/node_modules apps/*/dist packages/*/node_modules packages/*/dist"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
