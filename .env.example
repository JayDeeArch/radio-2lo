# =====================================================================
#  Szkolne Radio - konfiguracja
#  Skopiuj do .env i uzupełnij:  cp .env.example .env
# =====================================================================

# ---- Baza danych ----------------------------------------------------
# Używane tylko wewnątrz sieci Dockera (postgres://…@db:5432/…).
# Gdy uruchamiasz API bez Dockera, podaj localhost i uruchom Postgres samodzielnie.
POSTGRES_USER=radio
POSTGRES_PASSWORD=
POSTGRES_DB=radio
# DATABASE_URL=postgres://radio:haslo@localhost:5432/radio

# ---- Aplikacja w panelu Spotify -------------------------------------
# https://developer.spotify.com/dashboard -> Create app
# UstawieniaRedirect URI musi być identyczne z SPOTIFY_REDIRECT_URI poniżej.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Pełny adres zwrotny OAuth. W produkcji np.:
#   https://radio.twojaszkola.pl/api/auth/spotify/callback
# Lokalnie (z tunnelem/cloudflared):
#   https://twoja-domena.dlaczegotu.pl/api/auth/spotify/callback
SPOTIFY_REDIRECT_URI=http://localhost:8080/api/auth/spotify/callback

# ID playlisty szkolnego radia. Znajdziesz go w linku:
#   https://open.spotify.com/playlist/37i9dQZF1DXcBWIGoYBM5M  ->  37i9dQZF1DXcBWIGoYBM5M
#
# UWAGA: playlista musi być współdzielona (w Spotify: "Zezwól na edycję").
# Bez tego API nie zwróci jej zawartości ani nie pozwoli niczego dodać.
SPOTIFY_PLAYLIST_ID=

# Rynek Spotify wpływa na dostępność utworów (dostępność różni się per kraj).
SPOTIFY_MARKET=PL

# ---- Sesje administratora -------------------------------------------
# Losowy ciąg, min. 32 znaki. Wygeneruj:
#   openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_DAYS=14

# ---- Dostęp do panelu ------------------------------------------------
# Lista kont Spotify, które mogą zalogować się do panelu, oddzielona przecinkami.
# Użyj `account_id` (stabilny identyfikator konta, pole dodane w maju 2026)
# albo zwykłego `id` użytkownika. Puste = każde konto Spotify może się zalogować.
#
# Puste jest wygodne na start (tylko Ty znasz adres /admin), ale na produkcji
# warto wpisać konkretne konto.
ADMIN_SPOTIFY_IDS=

# ---- Sieć -----------------------------------------------------------
# Port, na którym nginx nasłuchuje na hoście.
HTTP_PORT=8090
# Adres publiczny - używany do przekierowań po logowaniu OAuth.
PUBLIC_BASE_URL=http://localhost:8080
# Poziom logowania: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ---- Cloudflare Tunnel (opcjonalnie) ------------------------------------
# Token z Cloudflare Zero Trust -> Networks -> Tunnels.
# Uruchomienie:  docker compose --profile tunnel up -d
# Public hostname ustaw w panelu na http://web:80
CLOUDFLARE_TUNNEL_TOKEN=

# Używane tylko przez docker-compose.dev.yml (dev):
# DEV_PORT=5173
# VITE_API_PROXY=http://localhost:3000
